# Backend
PORT=8080
# Boş qalsa PGlite (WASM PostgreSQL, quraşdırma tələb etmir) backend/.data/pglite qovluğunda işləyir
DATABASE_URL=
# Boş qalsa yaddaşdaxili store (yalnız test üçün). Lokal: redis://127.0.0.1:6379
REDIS_URL=redis://127.0.0.1:6379
# in-process | external | off
SIM_MODE=in-process
# Simulyasiya saatının sürəti (1 = real vaxt, 10, 30)
SIM_SPEED=1
# Simulyasiyanın başlanğıcı (ISO). Boşdursa bu gün 07:50 Bakı vaxtı
SIM_START=
RESERVE_POOL=6
TOKEN_SECRET=change-me-secret
INTERNAL_KEY=dev-internal-key
# Production: hazır frontend-i backend özü versin
STATIC_DIR=

# Frontend (vite dev/preview proxy hədəfi)
VITE_BACKEND=http://localhost:8080
